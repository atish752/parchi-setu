# ParchiSetu Production Configuration
# Main Live Domain: https://parchi-setu.vercel.app/
PORT=3000

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration (Cloud SQL Backend)
# Run supabase_schema.sql in your Supabase SQL Editor to initialize tables
# -----------------------------------------------------------------------------
SUPABASE_URL=https://parchi-setu.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Next / Client Public Supabase Variables
NEXT_PUBLIC_SUPABASE_URL=https://parchi-setu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration (Test & Live keys)
# Main Website Approved: https://parchi-setu.vercel.app
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

# Razorpay Subscriptions / Autopay Plan IDs (Created in Razorpay Dashboard > Subscriptions > Plans)
# Monthly Plan: ₹399/mo (ParchiSetu Monthly OPD Pro)
RAZORPAY_PLAN_ID_MONTHLY=plan_...
# Annual Plan: ₹3,999/yr (ParchiSetu Annual Pro - Autopay 1 Year)
RAZORPAY_PLAN_ID_YEARLY=plan_...

# -----------------------------------------------------------------------------
# Firebase Configuration Credentials for ParchiSetu (Google Auth & Realtime Sync)
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyDuKEZoXCa0Yx1Y2OIOCvJ6BSz0rQhH31o
FIREBASE_AUTH_DOMAIN=parchi-setu.firebaseapp.com
FIREBASE_PROJECT_ID=parchi-setu
FIREBASE_STORAGE_BUCKET=parchi-setu.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=25140806834
FIREBASE_APP_ID=1:25140806834:web:6d1aaa7786c5f17da8b5ab

# Vercel Public Environment Variables (Next.js / Vite / Client compatible)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDuKEZoXCa0Yx1Y2OIOCvJ6BSz0rQhH31o
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=parchi-setu.firebaseapp.com
